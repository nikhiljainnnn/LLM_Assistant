# ============================================================
# LLM Assistant — Environment Configuration
# ============================================================

# --- App ---
APP_ENV=development           # development | staging | production
APP_SECRET_KEY=change-me-to-a-random-secret-key-32-chars
API_KEY=your-api-key-for-clients   # clients must send this in X-API-Key header

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- HuggingFace ---
HF_TOKEN=hf_...               # optional, for private/gated models
HF_DEFAULT_MODEL=mistralai/Mistral-7B-Instruct-v0.2
VLLM_BASE_URL=http://localhost:8000/v1  # optional, vLLM external URL

# --- Database & Cache ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_assistant
REDIS_URL=redis://localhost:6379/0

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WORKERS=1                     # increase in production

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- RAG / FAISS ---
VECTOR_STORE_PATH=./data/faiss_index
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5
EMBEDDING_DEVICE=cpu          # cpu | cuda

# --- Fine-tuning (LoRA) ---
FINETUNE_BASE_MODEL=meta-llama/Llama-2-7b-hf
FINETUNE_OUTPUT_DIR=./models/lora_adapter
FINETUNE_EPOCHS=3
FINETUNE_BATCH_SIZE=4
FINETUNE_LR=2e-4
FINETUNE_MAX_SEQ_LEN=512

# --- Memory ---
MAX_HISTORY_TURNS=10          # sliding window for conversation memory

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=60        # per minute per IP
RATE_LIMIT_TOKENS=50000       # total tokens per hour per API key

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json               # json | text

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=your-api-key-for-clients
VITE_APP_TITLE=AI Assistant
